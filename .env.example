# =============================================================================
# Template de variáveis de ambiente. Copie para .env e preencha — NUNCA commite.
# =============================================================================

# --- LLM (Groq — inferência rápida e gratuita) ---
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# --- Telemetria LLM (Langfuse) ---
# Obtenha em: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- MLflow (opcional — sobrescreve cfg.mlflow.tracking_uri) ---
# MLFLOW_TRACKING_URI=

# --- Configs (opcional — sobrescreve auto-discovery) ---
# MODEL_CONFIG_PATH=src/ibov_pipeline/configs/model_config.yaml
# AGENT_CONFIG_PATH=src/agent_pipeline/configs/agent_config.yaml
